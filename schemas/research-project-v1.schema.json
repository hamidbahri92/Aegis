{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/hamidbahri92/Aegis/main/schemas/research-project-v1.schema.json",
  "title": "Aegis QEC research project v1",
  "type": "object",
  "required": [
    "schema_version",
    "title",
    "authors",
    "research_question",
    "experiments",
    "artifacts",
    "claims",
    "paper"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "title": {"type": "string", "minLength": 1},
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "affiliation": {"type": "string"},
          "orcid": {"type": "string"},
          "email": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "keywords": {
      "oneOf": [
        {"type": "string"},
        {
          "type": "array",
          "items": {"type": "string"}
        }
      ]
    },
    "research_question": {"type": "string", "minLength": 1},
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "properties": {
          "id": {"type": "string"},
          "text": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "experiments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "manifest"],
        "properties": {
          "id": {"type": "string"},
          "manifest": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path"],
        "properties": {
          "id": {"type": "string"},
          "path": {"type": "string"},
          "kind": {"type": "string"},
          "description": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text", "evidence"],
        "properties": {
          "id": {"type": "string"},
          "type": {
            "enum": [
              "result",
              "interpretation",
              "method",
              "background",
              "limitation"
            ]
          },
          "text": {"type": "string"},
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["artifact"],
              "properties": {
                "artifact": {"type": "string"},
                "json_pointer": {"type": "string"},
                "predicate": {"type": "object"}
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "bibliography_files": {
      "type": "array",
      "items": {"type": "string"}
    },
    "paper": {
      "type": "object",
      "properties": {
        "venue": {"type": "string"},
        "abstract": {"type": "string"},
        "statement_of_need": {"type": "string"},
        "state_of_field": {"type": "string"},
        "software_design": {"type": "string"},
        "methods": {"type": "string"},
        "results_context": {"type": "string"},
        "limitations": {"type": "string"},
        "impact": {"type": "string"},
        "data_availability": {"type": "string"},
        "code_availability": {"type": "string"},
        "ai_usage_disclosure": {"type": "string"},
        "competing_interests": {"type": "string"},
        "funding": {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
